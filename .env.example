# Mapbox PUBLIC access token (pk.*). Get one at https://account.mapbox.com/access-tokens/
# Copy this file to `.env` and fill in your token. This is the RUNTIME token used
# to display the map. It is loaded by flutter_dotenv and passed to the SDK in
# lib/main.dart.
#
# NOTE: The native Mapbox SDK ALSO requires a separate SECRET download token
# (sk.* with the DOWNLOADS:READ scope) to build the app. That one does NOT go
# here — see the README "Mapbox setup" section for where it goes.
MAPBOX_PUBLIC_TOKEN=pk.your_public_token

# Supabase client configuration. Find these in Supabase Dashboard > Connect.
# The publishable/anon key is intended for client apps; never put a service-role
# key in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# NaviPet backend base URL (no trailing slash, no /auth suffix). Used for
# registration and any other direct-to-backend HTTP calls. Ask a project
# maintainer for the hosted URL, or run a local copy of
# https://github.com/Ben2104/NavipetBackend. Leave blank to run without
# registration; the rest of the app still works.
BACKEND_BASE_URL=https://navipetbackend.onrender.com
